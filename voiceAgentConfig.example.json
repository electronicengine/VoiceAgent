{
  "common": {
    "agentMode": "text",
    "alsaCaptureDevice": "",
    "alsaPlaybackDevice": ""
  },
  "accountsFilePath": "account.json",
  "accountsRootDir": ".voice_agent_browser/accounts",
  "browserPromptTimeoutSeconds": 240,
  "pythonToolScriptRoot": "scripts/",
  "pythonWebRunnerPath": "scripts/wb_runner.py",
  "skills": {
    "skillsEnabled": true,
    "skillsDir": "skills",
    "llamaEmbedModelPath": "models/granite-embedding-30m-english-Q8_0.gguf",
    "experiencesFilePath": "experiences/experiences.md",
    "maxExperienceLines": 100,
    "maxSkillsPerTurn": 3
  },
  "transcriber": {
    "provider": "azure",
    "captureDurationSeconds": 6,
    "vadEnabled": true,
    "vadFrameMs": 20,
    "vadStartSpeechMs": 200,
    "vadEndSilenceMs": 800,
    "vadMaxCaptureMs": 25000,
    "vadPreRollMs": 1000,
    "vadAmplitudeThreshold": 2500,
    "azure": {
      "azureSpeechKey": "",
      "azureSpeechRegion": "eastus"
    },
    "deepgram": {
      "deepgramApiKey": "",
      "deepgramBaseUrl": "https://api.deepgram.com",
      "deepgramModel": "nova-3",
      "deepgramSmartFormat": true,
      "deepgramPunctuate": true,
      "deepgramDiarize": false
    }
  },
  "interpreter": {
    "provider": "openai",
    "openai": {
      "openAiApiKey": "",
      "openAiBaseUrl": "https://api.openai.com/v1",
      "openAiModel": "gpt-4.1",
      "openAiAssistantId": "",
      "openAiRunPollIntervalMs": 500,
      "openAiRunPollTimeoutSeconds": 90,
      "systemPromptFilePath": "systemPrompt.txt"
    }
  },
  "synthesizer": {
    "provider": "azure",
    "azure": {
      "azureSpeechKey": "",
      "azureSpeechRegion": "eastus",
      "speechLanguage": "tr-TR",
      "speechSampleRate": 16000,
      "voiceName": "en-US-DustinMultilingualNeural"
    }
  },
  "robot": {
    "robotInterfaceEnabled": true,
    "robotIp": "127.0.0.1",
    "robotSendPort": 5005,
    "robotRecvPort": 5006,
    "robotConfigFilePath": "/usr/local/etc/gesture_config_tr.json"
  }
}